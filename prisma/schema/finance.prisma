model Transaction {
  id            String          @id @default(cuid())
  type          TransactionType
  amount        Decimal         @db.Decimal(10, 2)
  date          DateTime
  description   String?         @db.Text
  paymentMethod PaymentMethod   @default(CASH) @map("payment_method")

  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  deposit Deposit?
  expense Expense?
  tags    TransactionTag[]

  @@index([date])
  @@index([type])
  @@map("transactions")
}

model Deposit {
  id            String @id @default(cuid())
  transactionId String @unique @map("transaction_id")
  memberId      String @map("member_id")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  member      Member      @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@index([memberId])
  @@map("deposits")
}

model Expense {
  id            String        @id @default(cuid())
  transactionId String        @unique @map("transaction_id")
  categoryId    String        @map("category_id")
  status        ExpenseStatus @default(PENDING)
  receiptId     String?       @unique @map("receipt_id")

  transaction Transaction      @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  category    ExpenseCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  receipt     CloudinaryAsset? @relation(fields: [receiptId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@map("expenses")
}

model ExpenseCategory {
  id          String  @id @default(cuid())
  name        String  @unique @db.VarChar(100)
  description String? @db.Text
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  expenses Expense[]

  @@map("expense_categories")
}

model CloudinaryAsset {
  id           String     @id @default(cuid())
  publicId     String     @unique @map("public_id")
  secureUrl    String     @map("secure_url") @db.Text
  originalName String     @map("original_name") @db.VarChar(255)
  mimeType     String     @map("mime_type") @db.VarChar(100)
  size         Int
  width        Int?
  height       Int?
  uploadType   UploadType @map("upload_type")
  uploadedById String     @map("uploaded_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  expense Expense?

  @@index([uploadedById])
  @@map("cloudinary_assets")
}

model MonthClosing {
  id            String      @id @default(cuid())
  monthYear     String      @unique @map("month_year") @db.VarChar(7)
  status        MonthStatus @default(OPEN)
  totalExpenses Decimal     @map("total_expenses") @db.Decimal(10, 2)
  totalMeals    Decimal     @map("total_meals") @db.Decimal(10, 2)
  mealRate      Decimal     @map("meal_rate") @db.Decimal(10, 2)

  closedAt   DateTime? @map("closed_at")
  closedById String?   @map("closed_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  balances MemberBalance[]

  @@index([status])
  @@map("month_closings")
}

model MemberBalance {
  id             String  @id @default(cuid())
  monthClosingId String  @map("month_closing_id")
  memberId       String  @map("member_id")
  totalDeposits  Decimal @map("total_deposits") @db.Decimal(10, 2)
  totalMealCost  Decimal @map("total_meal_cost") @db.Decimal(10, 2)
  carriedForward Decimal @map("carried_forward") @db.Decimal(10, 2)
  finalBalance   Decimal @map("final_balance") @db.Decimal(10, 2)

  monthClosing MonthClosing @relation(fields: [monthClosingId], references: [id], onDelete: Restrict)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@index([monthClosingId])
  @@index([memberId])
  @@map("member_balances")
}

model Tag {
  id       String @id @default(cuid())
  name     String @unique @db.VarChar(50)
  colorHex String @map("color_hex") @db.VarChar(7)

  transactions TransactionTag[]

  @@map("tags")
}

model TransactionTag {
  transactionId String @map("transaction_id")
  tagId         String @map("tag_id")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@map("transaction_tags")
}
