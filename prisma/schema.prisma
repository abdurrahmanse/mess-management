generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// ENUMS
// =========================================================================

enum Role {
  ADMIN
  MANAGER
  MEMBER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TransactionType {
  DEPOSIT
  EXPENSE
  TRANSFER
  REFUND
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CREDIT
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum UploadType {
  AVATAR
  RECEIPT
  DOCUMENT
}

enum ExpenseType {
  FIXED
  VARIABLE
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  GUEST
}

enum NotificationType {
  SYSTEM
  FINANCIAL
  REMINDER
  ALERT
}

enum ActivityType {
  CREATE
  UPDATE
  DELETE
  LOGIN
  EXPORT
}

enum MonthStatus {
  OPEN
  FROZEN
  CLOSED
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum DocumentType {
  INVOICE
  CONTRACT
  GUIDELINE
}

// =========================================================================
// AUTHENTICATION MODELS (Better Auth)
// =========================================================================

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  role   Role       @default(MEMBER)
  status UserStatus @default(ACTIVE)

  sessions      Session[]
  accounts      Account[]
  member        Member?
  activityLogs  ActivityLog[]
  notifications Notification[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verifications")
}

// =========================================================================
// CORE BUSINESS MODELS
// =========================================================================

model Member {
  id         String    @id @default(cuid())
  userId     String?   @unique @map("user_id")
  firstName  String    @map("first_name") @db.VarChar(100)
  lastName   String    @map("last_name") @db.VarChar(100)
  phone      String?   @db.VarChar(20)
  roomNumber String?   @map("room_number") @db.VarChar(20)
  joinDate   DateTime  @default(now()) @map("join_date")
  leaveDate  DateTime? @map("leave_date")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user           User?           @relation(fields: [userId], references: [id], onDelete: Restrict)
  deposits       Deposit[]
  shoppings      Shopping[]
  mealRecords    MealRecord[]
  memberBalances MemberBalance[]

  @@index([userId])
  @@map("members")
}

model Transaction {
  id            String          @id @default(cuid())
  type          TransactionType
  amount        Decimal         @db.Decimal(10, 2)
  date          DateTime
  description   String?         @db.Text
  paymentMethod PaymentMethod   @default(CASH) @map("payment_method")

  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  deposit Deposit?
  expense Expense?
  tags    TransactionTag[]

  @@index([date])
  @@index([type])
  @@map("transactions")
}

model Deposit {
  id            String @id @default(cuid())
  transactionId String @unique @map("transaction_id")
  memberId      String @map("member_id")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  member      Member      @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@index([memberId])
  @@map("deposits")
}

model Expense {
  id            String        @id @default(cuid())
  transactionId String        @unique @map("transaction_id")
  categoryId    String        @map("category_id")
  status        ExpenseStatus @default(PENDING)
  receiptId     String?       @unique @map("receipt_id")

  transaction Transaction      @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  category    ExpenseCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  receipt     CloudinaryAsset? @relation(fields: [receiptId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@map("expenses")
}

model ExpenseCategory {
  id          String  @id @default(cuid())
  name        String  @unique @db.VarChar(100)
  description String? @db.Text
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  expenses Expense[]

  @@map("expense_categories")
}

model CloudinaryAsset {
  id           String     @id @default(cuid())
  publicId     String     @unique @map("public_id")
  secureUrl    String     @map("secure_url") @db.Text
  originalName String     @map("original_name") @db.VarChar(255)
  mimeType     String     @map("mime_type") @db.VarChar(100)
  size         Int
  width        Int?
  height       Int?
  uploadType   UploadType @map("upload_type")
  uploadedById String     @map("uploaded_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  expense Expense?

  @@index([uploadedById])
  @@map("cloudinary_assets")
}

// =========================================================================
// SUPPORTING & EXTENDED MODELS
// =========================================================================

model Shopping {
  id          String   @id @default(cuid())
  date        DateTime
  totalAmount Decimal  @map("total_amount") @db.Decimal(10, 2)
  shopperId   String   @map("shopper_id")

  shopper Member         @relation(fields: [shopperId], references: [id], onDelete: Restrict)
  items   ShoppingItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([date])
  @@index([shopperId])
  @@map("shopping")
}

model ShoppingItem {
  id         String  @id @default(cuid())
  shoppingId String  @map("shopping_id")
  name       String  @db.VarChar(255)
  quantity   Decimal @db.Decimal(10, 2)
  unitId     String? @map("unit_id")
  price      Decimal @db.Decimal(10, 2)

  shopping Shopping @relation(fields: [shoppingId], references: [id], onDelete: Cascade)
  unit     Unit?    @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@index([shoppingId])
  @@map("shopping_items")
}

model Unit {
  id           String @id @default(cuid())
  name         String @unique @db.VarChar(50)
  abbreviation String @db.VarChar(20)

  shoppingItems ShoppingItem[]

  @@map("units")
}

model MealRecord {
  id       String   @id @default(cuid())
  memberId String   @map("member_id")
  date     DateTime
  type     MealType
  quantity Decimal  @db.Decimal(4, 2)

  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([memberId, date, type])
  @@index([memberId, date])
  @@map("meal_records")
}

model MonthClosing {
  id            String      @id @default(cuid())
  monthYear     String      @unique @map("month_year") @db.VarChar(7)
  status        MonthStatus @default(OPEN)
  totalExpenses Decimal     @map("total_expenses") @db.Decimal(10, 2)
  totalMeals    Decimal     @map("total_meals") @db.Decimal(10, 2)
  mealRate      Decimal     @map("meal_rate") @db.Decimal(10, 2)

  closedAt   DateTime? @map("closed_at")
  closedById String?   @map("closed_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  balances MemberBalance[]

  @@index([status])
  @@map("month_closings")
}

model MemberBalance {
  id             String  @id @default(cuid())
  monthClosingId String  @map("month_closing_id")
  memberId       String  @map("member_id")
  totalDeposits  Decimal @map("total_deposits") @db.Decimal(10, 2)
  totalMealCost  Decimal @map("total_meal_cost") @db.Decimal(10, 2)
  carriedForward Decimal @map("carried_forward") @db.Decimal(10, 2)
  finalBalance   Decimal @map("final_balance") @db.Decimal(10, 2)

  monthClosing MonthClosing @relation(fields: [monthClosingId], references: [id], onDelete: Restrict)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@index([monthClosingId])
  @@index([memberId])
  @@map("member_balances")
}

model ActivityLog {
  id         String       @id @default(cuid())
  userId     String?      @map("user_id")
  action     ActivityType
  entityType String       @map("entity_type") @db.VarChar(100)
  entityId   String       @map("entity_id")
  metadata   Json?

  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

model Notification {
  id      String           @id @default(cuid())
  userId  String           @map("user_id")
  type    NotificationType
  title   String           @db.VarChar(255)
  message String           @db.Text
  isRead  Boolean          @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model Settings {
  id              String  @id @default(cuid())
  messName        String  @default("My Mess") @map("mess_name") @db.VarChar(100)
  currency        String  @default("BDT") @db.VarChar(10)
  timezone        String  @default("Asia/Dhaka") @db.VarChar(50)
  defaultMealRate Decimal @default(0.0) @map("default_meal_rate") @db.Decimal(10, 2)

  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id")

  @@map("settings")
}

model Tag {
  id       String @id @default(cuid())
  name     String @unique @db.VarChar(50)
  colorHex String @map("color_hex") @db.VarChar(7)

  transactions TransactionTag[]

  @@map("tags")
}

model TransactionTag {
  transactionId String @map("transaction_id")
  tagId         String @map("tag_id")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@map("transaction_tags")
}
